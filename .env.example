# Optional server-only settings. Copy only needed values to ignored .env.server.local.
# Never expose provider keys through VITE_ variables or commit credentials.
# start:demo fixes this loopback origin and keeps COACH_MODE=authored.
HOST=127.0.0.1
PORT=4364
PUBLIC_ORIGIN=http://127.0.0.1:4364
COACH_MODE=authored

# Explicitly authorized adult recording session only; omitted means disabled.
# These enable Sol-ending feedback, not TASK11.19 or general child-live operation.
# EQ_GARDEN_AI_DEMO=1
# EQ_GARDEN_AI_SESSION=recording
# OPENAI_API_KEY=
# Preserve evidence/demo-ai-20260919/openai-attempts.jsonl and its prior ledger.
# The authorized $10 total includes prior reservations; never reset accounting.

# Optional player-written-text narration; tracked authored audio needs no key.
# EQ_CAST_DYNAMIC_VOICE=1
# FISH_API_KEY=
# Dynamic files stay private in ignored .cache/cast-audio-dynamic/.
